# 智谱 AI（BigModel / GLM）配置
# 复制本文件为 .env 并填入你的 Key：  cp .env.example .env

# 必填：智谱开放平台 API Key（https://open.bigmodel.cn/ 控制台获取）
ZHIPU_API_KEY=

# 选填：默认文本模型（追问 / 此刻 / 深度命理 都用它）
# 文本主力推荐 glm-4.5-air；如需更强可换 glm-4.6 等
ZHIPU_MODEL=glm-4.5-air

# 选填：深度命理分析单独用更强模型（留空则用 ZHIPU_MODEL）
# glm-4.5-air 偶发拒答/截断，已加重试兜底；若有 glm-4.6 / glm-4.6v 额度，填这里更稳
ZHIPU_ANALYSIS_MODEL=

# 选填：接口地址，一般无需改动
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 选填：服务端口（默认 3100；被占用会自动顺延，H5 代理已读取同一变量）
SERVER_PORT=3100
