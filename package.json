{
  "name": "xinxiang-ai-bazi",
  "version": "1.0.0",
  "private": true,
  "description": "心象 · AI 八字、东方日签与自我观察，支持 React 网页及微信/抖音小程序",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SherlockMF/xinxiang-ai-bazi.git"
  },
  "keywords": [
    "xinxiang",
    "bazi",
    "ai",
    "chinese-metaphysics",
    "react",
    "taro",
    "wechat-miniprogram",
    "douyin-miniprogram"
  ],
  "scripts": {
    "install:web": "pnpm -C apps/web install --frozen-lockfile",
    "postinstall": "pnpm --filter xinxiang-miniapp exec weapp-tw patch",
    "dev": "concurrently --kill-others -n web,server \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm -C apps/web dev",
    "dev:server": "pnpm --filter xinxiang-server dev",
    "dev:h5": "pnpm --filter xinxiang-miniapp dev:h5",
    "dev:weapp": "pnpm --filter xinxiang-miniapp dev:weapp",
    "dev:tt": "pnpm --filter xinxiang-miniapp dev:tt",
    "dev:legacy": "concurrently --kill-others -n h5,server \"pnpm dev:h5\" \"pnpm dev:server\"",
    "build": "pnpm build:web && pnpm build:h5 && pnpm build:weapp && pnpm build:tt && pnpm build:server",
    "build:web": "pnpm -C apps/web build",
    "build:h5": "pnpm --filter xinxiang-miniapp build:h5",
    "build:weapp": "pnpm --filter xinxiang-miniapp build:weapp",
    "build:tt": "pnpm --filter xinxiang-miniapp build:tt",
    "build:server": "pnpm --filter xinxiang-server build",
    "build:pack": "pnpm build:weapp && pnpm build:tt",
    "preview:web": "pnpm -C apps/web preview",
    "preview:weapp": "pnpm --filter xinxiang-miniapp preview:weapp",
    "preview:tt": "pnpm --filter xinxiang-miniapp preview:tt",
    "test": "pnpm -C apps/web test && pnpm --filter xinxiang-miniapp test && pnpm test:offline",
    "typecheck": "pnpm -C apps/web typecheck && pnpm --filter xinxiang-miniapp typecheck && pnpm --filter xinxiang-server typecheck",
    "tsc": "pnpm typecheck",
    "lint": "pnpm --filter xinxiang-miniapp lint",
    "lint:build": "pnpm --filter xinxiang-miniapp lint:build",
    "validate": "pnpm typecheck && pnpm lint:build",
    "test:offline": "node skills/minitool-zip-builder/scripts/audit_artifact.mjs apps/offline && node skills/minitool-zip-builder/scripts/audit_artifact.mjs artifacts/xinxiang-minitool.zip"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tarojs/plugin-mini-ci@4.1.9": "patches/@tarojs__plugin-mini-ci@4.1.9.patch"
    }
  }
}
